APP_NAME="Citas Hospital HSJ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQL Server local CITAS. Usuario y clave vacios para autenticacion de Windows.
DB_CONNECTION=sqlsrv
DB_HOST=(local)
DB_PORT=
DB_DATABASE=CITAS
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=10

# Completar con la conexion al servidor SIGH autorizado.
SIGH_DB_HOST=
SIGH_DB_PORT=1433
SIGH_DB_DATABASE=SIGH
SIGH_DB_USERNAME=
SIGH_DB_PASSWORD=
SIGH_DB_ENCRYPT=no
SIGH_DB_TRUST_SERVER_CERTIFICATE=yes

REMOTE_QUERY_ENABLED=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
